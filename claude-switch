#!/usr/bin/env bash
# claude-switch — troca de conta no Claude Code sem o ritual de /logout + browser.
#
# Como funciona:
#   - macOS: credenciais OAuth vivem no Keychain (service "Claude Code-credentials", account = $USER).
#   - Linux: credenciais OAuth vivem em ~/.claude/.credentials.json.
#   - Metadados da conta vivem em ~/.claude.json (.oauthAccount, .userID).
#   - Um "profile" é um snapshot dos dois: ~/.claude/profiles/<nome>.json.
#
# Uso:
#   claude-switch save <nome>     # salva a conta atualmente logada como <nome>
#   claude-switch use  <nome>     # troca pra esse profile (sem browser)
#   claude-switch list            # lista profiles + email de cada
#   claude-switch current         # mostra qual conta está ativa
#   claude-switch logout          # limpa credenciais (sem apagar profiles salvos)
#   claude-switch rm   <nome>     # apaga um profile
#   claude-switch doctor          # verifica pré-requisitos e estado
#
# Fluxo típico (primeira vez):
#   1) logado na conta A:   claude-switch save trabalho
#   2) claude-switch logout && claude   # loga na conta B no browser
#   3) logado na conta B:   claude-switch save pessoal
#   4) daqui em diante:     claude-switch use trabalho | use pessoal

set -euo pipefail

SERVICE="Claude Code-credentials"
ACCOUNT="${USER:-$(id -un 2>/dev/null || echo "")}"
OS_NAME="$(uname -s)"
CLAUDE_JSON="${HOME}/.claude.json"
CLAUDE_DIR="${HOME}/.claude"
LINUX_CREDENTIALS_JSON="${CLAUDE_DIR}/.credentials.json"
PROFILES_DIR="${CLAUDE_DIR}/profiles"

mkdir -p "${PROFILES_DIR}"

die()  { printf 'erro: %s\n' "$*" >&2; exit 1; }
info() { printf '%s\n' "$*"; }

require_jq() { command -v jq >/dev/null || die "jq não encontrado (macOS: brew install jq; Linux: use o gerenciador de pacotes da sua distro)"; }

claude_version() {
  if command -v timeout >/dev/null; then
    timeout 3 claude --version 2>/dev/null | head -1 || echo 'versão desconhecida'
  else
    claude --version 2>/dev/null | head -1 || echo 'versão desconhecida'
  fi
}

credential_backend() {
  case "${OS_NAME}" in
    Darwin) printf 'keychain' ;;
    Linux)  printf 'file' ;;
    *)      printf 'unsupported' ;;
  esac
}

backend_label() {
  case "$(credential_backend)" in
    keychain) printf 'Keychain' ;;
    file) printf '%s' "${LINUX_CREDENTIALS_JSON}" ;;
    *) printf 'não suportado' ;;
  esac
}

require_supported_os() {
  case "$(credential_backend)" in
    keychain|file) ;;
    *) die "sistema não suportado: ${OS_NAME} (suportados: macOS/Darwin e Linux)" ;;
  esac
}

keychain_read() {
  command -v security >/dev/null || return 0
  security find-generic-password -s "${SERVICE}" -a "${ACCOUNT}" -w 2>/dev/null || true
}

keychain_write() {
  command -v security >/dev/null || die "'security' CLI ausente"
  local creds="$1"
  security add-generic-password -U -s "${SERVICE}" -a "${ACCOUNT}" -w "${creds}" >/dev/null
}

keychain_delete() {
  command -v security >/dev/null || return 0
  security delete-generic-password -s "${SERVICE}" -a "${ACCOUNT}" >/dev/null 2>&1 || true
}

file_read() {
  [[ -f "${LINUX_CREDENTIALS_JSON}" ]] || return 0
  jq -c '.claudeAiOauth // empty' "${LINUX_CREDENTIALS_JSON}" 2>/dev/null || true
}

file_write() {
  local creds="$1"
  mkdir -p "${CLAUDE_DIR}"
  local tmp; tmp="$(mktemp "${LINUX_CREDENTIALS_JSON}.tmp.XXXXXX")"

  if [[ -f "${LINUX_CREDENTIALS_JSON}" ]]; then
    jq --argjson credentials "${creds}" '.claudeAiOauth = $credentials' "${LINUX_CREDENTIALS_JSON}" > "${tmp}"
  else
    jq -n --argjson credentials "${creds}" '{claudeAiOauth: $credentials}' > "${tmp}"
  fi

  chmod 600 "${tmp}"
  mv "${tmp}" "${LINUX_CREDENTIALS_JSON}"
}

file_delete() {
  [[ -f "${LINUX_CREDENTIALS_JSON}" ]] || return 0
  local tmp; tmp="$(mktemp "${LINUX_CREDENTIALS_JSON}.tmp.XXXXXX")"
  jq 'del(.claudeAiOauth)' "${LINUX_CREDENTIALS_JSON}" > "${tmp}"
  chmod 600 "${tmp}"
  mv "${tmp}" "${LINUX_CREDENTIALS_JSON}"
}

credentials_read() {
  require_supported_os
  case "$(credential_backend)" in
    keychain) keychain_read ;;
    file) file_read ;;
  esac
}

credentials_write() {
  require_supported_os
  local creds="$1"
  case "$(credential_backend)" in
    keychain) keychain_write "${creds}" ;;
    file) file_write "${creds}" ;;
  esac
}

credentials_delete() {
  require_supported_os
  case "$(credential_backend)" in
    keychain) keychain_delete ;;
    file) file_delete ;;
  esac
}

current_email() {
  [[ -f "${CLAUDE_JSON}" ]] || { echo "(sem ~/.claude.json)"; return; }
  jq -r '.oauthAccount.emailAddress // "(sem oauthAccount)"' "${CLAUDE_JSON}"
}

profile_path() { printf '%s/%s.json' "${PROFILES_DIR}" "$1"; }

validate_profile_name() {
  local name="$1"
  [[ "${name}" != *"/"* && "${name}" != "." && "${name}" != ".." && -n "${name}" ]] || die "nome de profile inválido: ${name}"
}

cmd_current() {
  require_jq
  local creds email
  creds="$(credentials_read)"
  email="$(current_email)"
  if [[ -z "${creds}" ]]; then
    info "ativo: ${email} (sem credenciais em $(backend_label) — você está deslogado)"
  else
    info "ativo: ${email}"
  fi
}

cmd_save() {
  require_jq
  local name="${1:-}"; [[ -n "${name}" ]] || die "uso: claude-switch save <nome>"
  validate_profile_name "${name}"
  local creds; creds="$(credentials_read)"
  [[ -n "${creds}" ]] || die "sem credenciais ativas em $(backend_label) — faça login antes (claude)"
  [[ -f "${CLAUDE_JSON}" ]] || die "~/.claude.json não encontrado"

  local oauth_account user_id
  oauth_account="$(jq -c '.oauthAccount // null' "${CLAUDE_JSON}")"
  user_id="$(jq -r '.userID // ""' "${CLAUDE_JSON}")"

  local tmp; tmp="$(mktemp "$(profile_path "${name}").tmp.XXXXXX")"
  jq -n \
    --argjson credentials "${creds}" \
    --argjson oauthAccount "${oauth_account}" \
    --arg userID "${user_id}" \
    '{credentials: $credentials, oauthAccount: $oauthAccount, userID: $userID}' \
    > "${tmp}"
  chmod 600 "${tmp}"
  mv "${tmp}" "$(profile_path "${name}")"

  info "salvo profile '${name}' ($(jq -r '.oauthAccount.emailAddress // "?"' "$(profile_path "${name}")"))"
}

cmd_use() {
  require_jq
  local name="${1:-}"; [[ -n "${name}" ]] || die "uso: claude-switch use <nome>"
  validate_profile_name "${name}"
  local p; p="$(profile_path "${name}")"
  [[ -f "${p}" ]] || die "profile '${name}' não existe — use 'claude-switch list'"
  [[ -f "${CLAUDE_JSON}" ]] || die "~/.claude.json não encontrado"

  local current_creds; current_creds="$(credentials_read)"
  if [[ -n "${current_creds}" ]]; then
    local cur_email; cur_email="$(current_email)"
    local found=""
    shopt -s nullglob
    local f
    for f in "${PROFILES_DIR}"/*.json; do
      if [[ "$(jq -r '.oauthAccount.emailAddress // ""' "${f}")" == "${cur_email}" ]]; then
        found="$(basename "${f}" .json)"
        break
      fi
    done
    shopt -u nullglob
    if [[ -z "${found}" ]]; then
      printf "aviso: a conta atual (%s) não está salva em nenhum profile.\n" "${cur_email}" >&2
      printf "       digite 'y' pra continuar e perder a sessão, ou Ctrl-C pra cancelar: " >&2
      read -r reply
      [[ "${reply}" == "y" || "${reply}" == "Y" ]] || die "abortado"
    fi
  fi

  local creds; creds="$(jq -c '.credentials' "${p}")"
  [[ "${creds}" != "null" ]] || die "profile '${name}' não tem credenciais"
  credentials_write "${creds}"

  local tmp; tmp="$(mktemp "${CLAUDE_JSON}.tmp.XXXXXX")"
  jq \
    --slurpfile prof "${p}" \
    '.oauthAccount = $prof[0].oauthAccount | .userID = $prof[0].userID' \
    "${CLAUDE_JSON}" > "${tmp}"
  chmod --reference="${CLAUDE_JSON}" "${tmp}" 2>/dev/null || true
  mv "${tmp}" "${CLAUDE_JSON}"

  info "ativo: $(jq -r '.oauthAccount.emailAddress // "?"' "${p}") (profile '${name}')"
}

cmd_list() {
  require_jq
  local cur_email; cur_email="$(current_email)"
  local has_creds=""; [[ -n "$(credentials_read)" ]] && has_creds="1"

  shopt -s nullglob
  local files=("${PROFILES_DIR}"/*.json)
  shopt -u nullglob
  if (( ${#files[@]} == 0 )); then
    info "(nenhum profile salvo — use 'claude-switch save <nome>')"
    return
  fi
  local f
  for f in "${files[@]}"; do
    local name email mark
    name="$(basename "${f}" .json)"
    email="$(jq -r '.oauthAccount.emailAddress // "?"' "${f}")"
    mark=" "
    [[ -n "${has_creds}" && "${email}" == "${cur_email}" ]] && mark="*"
    printf '%s %-20s %s\n' "${mark}" "${name}" "${email}"
  done
}

cmd_logout() {
  credentials_delete
  info "credenciais removidas de $(backend_label) (profiles salvos foram mantidos)"
}

cmd_rm() {
  local name="${1:-}"; [[ -n "${name}" ]] || die "uso: claude-switch rm <nome>"
  validate_profile_name "${name}"
  local p; p="$(profile_path "${name}")"
  [[ -f "${p}" ]] || die "profile '${name}' não existe"
  rm "${p}"
  info "removido profile '${name}'"
}

cmd_doctor() {
  local fail=0
  local ok="\033[1;32mok\033[0m"
  local nok="\033[1;31mfalta\033[0m"
  local warn="\033[1;33maviso\033[0m"

  check() { printf "  [%b] %s\n" "$1" "$2"; }

  case "$(credential_backend)" in
    keychain) check "${ok}" "macOS ($(sw_vers -productVersion 2>/dev/null || echo '?')) — backend: Keychain" ;;
    file) check "${ok}" "Linux — backend: ${LINUX_CREDENTIALS_JSON}" ;;
    *) check "${nok}" "sistema não suportado (${OS_NAME}) — suportados: macOS/Darwin e Linux"; fail=1 ;;
  esac

  if command -v bash >/dev/null; then
    check "${ok}" "bash"
  else
    check "${nok}" "bash não encontrado"; fail=1
  fi

  if [[ "$(credential_backend)" == "keychain" ]]; then
    if command -v security >/dev/null; then
      check "${ok}" "security CLI"
    else
      check "${nok}" "security CLI ausente"; fail=1
    fi
  fi

  if command -v jq >/dev/null; then
    check "${ok}" "jq ($(jq --version))"
  else
    check "${nok}" "jq não instalado"; fail=1
  fi

  if command -v claude >/dev/null; then
    check "${ok}" "claude CLI ($(claude_version))"
  else
    check "${warn}" "comando 'claude' não está no PATH — instale o Claude Code (npm i -g @anthropic-ai/claude-code)"
  fi

  if [[ -f "${CLAUDE_JSON}" ]]; then
    check "${ok}" "${CLAUDE_JSON}"
  else
    check "${warn}" "${CLAUDE_JSON} não existe — rode 'claude' uma vez antes de 'save'"
  fi

  if [[ "$(credential_backend)" == "file" ]]; then
    if [[ -f "${LINUX_CREDENTIALS_JSON}" ]]; then
      check "${ok}" "${LINUX_CREDENTIALS_JSON}"
    else
      check "${warn}" "${LINUX_CREDENTIALS_JSON} não existe — faça login com 'claude' antes do primeiro 'save'"
    fi
  fi

  if [[ -n "$(credentials_read)" ]]; then
    if command -v jq >/dev/null && [[ -f "${CLAUDE_JSON}" ]]; then
      check "${ok}" "credenciais ativas em $(backend_label) (conta ativa: $(current_email))"
    else
      check "${ok}" "credenciais ativas em $(backend_label)"
    fi
  else
    check "${warn}" "sem credenciais ativas em $(backend_label) — você está deslogado (faça login com 'claude' antes de 'save')"
  fi

  shopt -s nullglob
  local files=("${PROFILES_DIR}"/*.json)
  shopt -u nullglob
  check "${ok}" "profiles salvos: ${#files[@]} (em ${PROFILES_DIR})"

  echo
  if [[ ${fail} -eq 0 ]]; then
    info "tudo ok pra rodar."
  else
    die "alguns pré-requisitos obrigatórios estão faltando — veja acima."
  fi
}

cmd_help() {
  sed -n '2,/^set -euo/p' "$0" | sed '$d' | sed 's/^# \{0,1\}//'
}

case "${1:-help}" in
  current) shift; cmd_current "$@" ;;
  save)    shift; cmd_save    "$@" ;;
  use)     shift; cmd_use     "$@" ;;
  list|ls) shift; cmd_list    "$@" ;;
  logout)  shift; cmd_logout  "$@" ;;
  rm)      shift; cmd_rm      "$@" ;;
  doctor)  shift; cmd_doctor  "$@" ;;
  help|-h|--help) cmd_help ;;
  *) cmd_help; exit 1 ;;
esac
